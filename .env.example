# Copy to .env and fill in. In Coolify, set the same variables on the application.

# Postgres connection (local: docker-compose.dev.yml)
DATABASE_URL=postgres://morpheus:morpheus@localhost:5433/morpheus
# Long random string, e.g. `openssl rand -hex 32`. Signs logins; keep it stable.
PAYLOAD_SECRET=change-me
# Public address of the site, without a trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# The first admin user, created on start-up (and by `npm run seed`) while there are no users
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Media storage: Leafcloud Object Storage (S3-compatible, Amsterdam). Leave S3_BUCKET empty to store
# uploads on local disk in ./media (development).
S3_ENDPOINT=https://leafcloud.store
S3_REGION=europe-nl
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mail (verification, password reset, login links) over SMTP: Scaleway Transactional Email in
# production. Leave SMTP_HOST empty to print e-mails to the console instead. For local testing,
# Mailpit from docker-compose.dev.yml: SMTP_HOST=localhost, SMTP_PORT=1025, no user/password,
# inbox at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@morpheus-szinmuhely.hu
EMAIL_FROM_NAME=Morpheus Színműhely

# Online payment (lib/payments). PAYMENT_PROVIDER=mollie on the live site; `mock` (the default in
# development) is a fake checkout at /fizetes/mock/… and is refused on a deployed site.
PAYMENT_PROVIDER=mock
# Mollie API key: test_… for test mode (staging), live_… for real payments. Never in the database.
MOLLIE_API_KEY=
# Invoicing (lib/invoicing): off (default — prepared, never sent) | test (a Számlázz.hu TEST account)
# | live (the live site only). The real account's key never goes into a local .env.
INVOICING_MODE=off
SZAMLAZZ_AGENT_KEY=

# Facebook events → Előadás-időpontok (lib/facebook; the admin's "Szinkronizálás a Facebookról").
# The page's id (not the profile.php one) and a Page access token of OUR OWN Meta app with
# pages_read_engagement — never another app's token (e.g. a WordPress plugin's).
FACEBOOK_PAGE_ID=162350683629276
FACEBOOK_PAGE_TOKEN=

# "Folytatás Google-fiókkal" (lib/google; README → Google login). Without them there is no button.
# Redirect URI to register: <NEXT_PUBLIC_SERVER_URL>/belepes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
